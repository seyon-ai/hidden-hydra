rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: everyone signed-in can read; only the owner can write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // DM chats: any signed-in user (membership is checked client-side;
    // tighten with a members check if you want server-enforced DM privacy).
    match /chats/{id} {
      allow read, write: if request.auth != null;
    }

    // Groups + per-member wrapped E2EE room keys.
    match /groups/{gid} {
      allow read, write: if request.auth != null;
      match /keys/{uid} {
        // wraps-map: any signed-in member may merge-write wraps for others
        // (that is how keys propagate); only the owner may delete.
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /friendRequests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
    }

    // Moderation log: write-only append; nobody (client-side) can read it.
    match /moderation/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
