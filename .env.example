# ── Hidden Hydra server secrets ─────────────────────────────
# Copy to .env for local dev (node dev-server.mjs), and add the SAME
# keys in Vercel → Project → Settings → Environment Variables.
# NEVER commit a real .env file.

# Groq (AI assistant / welcome / moderation) — https://console.groq.com/keys
GROQ_API_KEY=

# imgbb (image attachments & profile photos) — https://api.imgbb.com/
IMGBB_API_KEY=

# Optional: model override (default llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: comma-separated origin allow-list for /api (leave unset = open)
# APP_ORIGIN=https://your-app.vercel.app
